# Sesuaikan jika MySQL Laragon menggunakan password atau port berbeda.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ruralb2b
DB_USER=root
DB_PASSWORD=

# Wajib diisi dengan nilai acak yang panjang. Jangan commit nilai asli.
# Contoh membuat secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=ganti-dengan-secret-acak-yang-panjang
JWT_ALGORITHM=HS256
JWT_EXPIRES_MINUTES=60
JWT_ISSUER=ruralb2b-api
JWT_AUDIENCE=ruralb2b-client

# Pisahkan dengan koma. Gunakan * hanya untuk development.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=true

# Direktori penyimpanan dokumen verifikasi (harus di luar folder static).
# Kosongkan untuk memakai backend/storage/verification_documents.
VERIFICATION_UPLOAD_DIR=
MAX_VERIFICATION_DOCUMENT_SIZE=5242880
MAX_VERIFICATION_DOCUMENTS=10

# Direktori penyimpanan gambar produk (harus di luar folder static).
# Kosongkan untuk memakai backend/storage/product_images.
PRODUCT_IMAGE_UPLOAD_DIR=
MAX_PRODUCT_IMAGE_SIZE=5242880
MAX_PRODUCT_IMAGES=5
MAX_CONTENT_LENGTH=10485760

# Direktori penyimpanan bukti pembayaran (harus di luar folder static).
# Kosongkan untuk memakai backend/storage/payment_proofs.
PAYMENT_PROOF_UPLOAD_DIR=
MAX_PAYMENT_PROOF_SIZE=5242880
MAX_CONTENT_LENGTH=10485760

# Telegram Bot API. Kosongkan jika notifikasi belum digunakan.
# Pengajuan tetap tersimpan meskipun Telegram tidak dikonfigurasi/gagal.
# Notifikasi dikirim saat: pengajuan verifikasi dibuat, disetujui, ditolak.
# Cara mengisi: buat bot via @BotFather (dapat TELEGRAM_BOT_TOKEN), lalu
# kirim pesan ke bot dan ambil chat ID (mis. via @userinfobot atau API
# getUpdates). TELEGRAM_CHAT_ID juga diterima sebagai alias.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_API_TIMEOUT=5
