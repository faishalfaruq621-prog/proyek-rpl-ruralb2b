    {
      "name": "Checkout",
      "item": [
        {
          "name": "POST /api/orders/checkout - Checkout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{buyer_token}}",
                "type": "text"
              },
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"shipping_address\": \"Jl. Contoh No. 1\",\n  \"buyer_note\": \"Tolong dikirim pagi hari\",\n  \"payment_method\": \"transfer\",\n  \"payment_reference\": \"TRX-20261109-001\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/orders/checkout",
              "host": ["{{base_url}}"],
              "path": ["orders", "checkout"]
            },
            "description": "Melakukan checkout keranjang aktif. Setiap group produk per penjual dibuat menjadi satu order terpisah.\nPrasyarat: buyer_token sudah diisi dan keranjang berisi item. Keranjang tidak boleh berisi produk milik profil pembeli sendiri (self_purchase_not_allowed).\nRespons berisi order_id yang diperlukan untuk request selanjutnya."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 201\", function () {",
                  "  pm.response.to.have.status(201);",
                  "});",
                  "pm.test(\"Response is valid JSON\", function () {",
                  "  pm.response.to.have.jsonBody();",
                  "});",
                  "pm.test(\"Response has success true\", function () {",
                  "  var json = pm.response.json();",
                  "  pm.expect(json.success).to.eql(true);",
                  "});",
                  "pm.test(\"Saves order_id from first order\", function () {",
                  "  var json = pm.response.json();",
                  "  if (json.data && json.data.orders && json.data.orders.length > 0) {",
                  "    var firstOrder = json.data.orders[0];",
                  "    if (firstOrder && firstOrder.id) {",
                  "      pm.collectionVariables.set(\"order_id\", firstOrder.id);",
                  "    }",
                  "  }",
                  "});"
                ]
              }
            }
          ],
          "response": []
        }
      ]
